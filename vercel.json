{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?_path=api/$1"
    },
    {
      "source": "/mcp/(.*)",
      "destination": "/api/index.py?_path=mcp/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py?_path=$1"
    }
  ]
}
